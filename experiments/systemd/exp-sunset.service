[Unit]
Description=Project Sunset experiments 19/21: the sunset bracket every evening until production has it (#10)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# install: replace USER and HOME with the Pi's user (funvill on timelaps, sunshine on the CM4)
User=USER
ExecStart=/bin/bash HOME/sunset/experiments/sunset-nightly.sh
RuntimeMaxSec=8h
Nice=5
