#!/usr/bin/env bash
# Test stub for stat -c %d: STUB_SAME_FS=1 reports every path on one device.
# Any other format (the sync's -c %s for the UPS log sizes) goes to the real stat.
if [[ "${1:-}" == -c && "${2:-}" != %d ]]; then
  PATH="${PATH#*/tests/stubs:}" exec stat "$@"
fi
[[ "${STUB_SAME_FS:-0}" == 1 ]] && { echo 1; exit 0; }
printf '%s' "${@: -1}" | cksum | cut -d' ' -f1
