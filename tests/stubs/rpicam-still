#!/usr/bin/env bash
# Test stub for rpicam-still. STUB_RPICAM=ok|fail|hang  STUB_LUX=<lux>
[[ -n "${STUB_CALLS:-}" ]] && echo "$*" >> "$STUB_CALLS"
# STUB_LOCK_PROBE=<lock file>: note in $STUB_CALLS.lock whether someone held that lock during the call.
if [[ -n "${STUB_LOCK_PROBE:-}" ]] && command -v flock >/dev/null 2>&1; then
  if flock -n "$STUB_LOCK_PROBE" true 2>/dev/null; then echo free; else echo held; fi >> "${STUB_CALLS:-/dev/null}.lock"
fi
# More modes: hang_term (ignores SIGTERM, like a child stuck in a driver call), nodng (exits 0
# but writes no DNG), nojson (no metadata file), failonce (the first call fails at once, as when
# another program holds the camera; later calls work), orphan (works, but leaves a child running
# that keeps every inherited file descriptor open for STUB_ORPHAN_S seconds).
case "${STUB_RPICAM:-ok}" in
  fail) echo "ERROR: *** no cameras available ***" >&2; exit 1 ;;
  hang) sleep 30; exit 0 ;;
  hang_term) trap '' TERM; sleep 30; exit 0 ;;
  failonce)
    once="${STUB_CALLS:-/tmp/stub}.failonce"
    if [[ ! -e "$once" ]]; then
      : > "$once"; echo "ERROR: *** failed to acquire camera: pipeline handler in use ***" >&2; exit 1
    fi ;;
  orphan) sleep "${STUB_ORPHAN_S:-4}" >/dev/null 2>&1 & ;;
esac
if [[ "$*" == *--list-cameras* ]]; then
  case "${STUB_CAMERA:-imx477}" in
    none) echo "No cameras available!"; exit 0 ;;
    *) echo "Available cameras"; echo "0 : ${STUB_CAMERA:-imx477} [4056x3040 12-bit RGGB] (/base/soc/i2c0mux/i2c@1/sensor@1a)"; exit 0 ;;
  esac
fi
out=""; meta=""; raw=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) out="$2"; shift ;;
    --metadata) meta="$2"; shift ;;
    --raw) raw=1 ;;
  esac
  shift
done
if [[ "$out" == *.bmp ]]; then
  python3 - "$out" "${STUB_RGB:-120,120,120}" <<'PY'
import struct, sys
r, g, b = map(int, sys.argv[2].split(","))
w, h = 160, 120
row = (w * 3 + 3) // 4 * 4
px = bytearray()
for _ in range(h):
    line = bytes([b, g, r]) * w
    px += line + bytes(row - len(line))
hdr = b"BM" + struct.pack("<IHHI", 54 + len(px), 0, 0, 54) + struct.pack("<IiiHHIIiiII", 40, w, h, 1, 24, 0, len(px), 0, 0, 0, 0)
open(sys.argv[1], "wb").write(hdr + bytes(px))
PY
  exit 0
fi
printf 'jpegdata' > "$out"
[[ $raw == 1 && "${STUB_RPICAM:-ok}" != nodng ]] && printf 'dngdata' > "${out%.jpg}.dng"
[[ -n "$meta" && "${STUB_RPICAM:-ok}" != nojson ]] && printf '{\n    "ExposureTime": 1000,\n    "Lux": %s,\n    "AnalogueGain": 1.0\n}\n' "${STUB_LUX:-1000}" > "$meta"
exit 0
