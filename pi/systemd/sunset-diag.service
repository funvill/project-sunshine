[Unit]
Description=Project Sunset temporary diagnostics page

# No [Install] section on purpose: this only ever runs when someone types `diag`.
[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/sunset
EnvironmentFile=-/home/pi/sunset/sunset.env
# Set by `diag start <camera> [rotation]`: which camera the page starts on.
EnvironmentFile=-/run/sunset-diag.env
# Capture pauses while the page is on (Steven, 2026-11-17), so the live view is not interrupted
# every 5 minutes while a camera is being aimed or focused. "+" runs these as root. ExecStopPost
# also runs when the page times out or fails, so capture always comes back.
# These two timers take both cameras.
# Except during a UPS low-battery pause (/run/sunset-ups.paused, pi/sunset-ups.py): then the timers
# are added to the pause's list, and the UPS monitor starts them when mains returns (review 2026-11-21).
ExecStartPre=+/bin/systemctl stop sunset-capture.timer sunset-dense.timer
ExecStart=/usr/bin/python3 /home/pi/sunset/sunset-diag.py
ExecStopPost=+/bin/sh -c 'if [ -e /run/sunset-ups.paused ]; then echo sunset-capture.timer sunset-dense.timer >> /run/sunset-ups.paused; else systemctl start sunset-capture.timer sunset-dense.timer; fi'
# The link file for the diag command. In RAM, so it costs no SD writes.
RuntimeDirectory=sunset-diag
NoNewPrivileges=yes
# The script exits cleanly after 30 minutes. This is only the backstop.
RuntimeMaxSec=1860
