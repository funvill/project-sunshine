# REFERENCE COPY of the non-secret settings in the live sunset.env on the Pi "timelaps" (Pi 3 B+,
# the pilot, UC-517 with the 6 mm lens). It is NOT the live file: the Pi reads ~/sunset/sunset.env,
# which nothing here updates. Use this to rebuild the Pi: copy it to ~/sunset/sunset.env and set
# the two site values. Last checked against changelog.md and CLAUDE.md on 2026-11-15; values
# marked "unverified" were not read back from the Pi.
# Never put real coordinates, addresses or passwords in this file (the repo is public).
# systemd EnvironmentFile: no comments after a value, and no quotes unless the value needs them.

CAM_NAME=wide
NAS_TARGET=/mnt/nas-camera/project_sunshine/

# Site: placeholders. Replace with the real values on the Pi only (east-positive longitude).
SITE_LAT=REPLACE_WITH_REAL_LATITUDE
SITE_LON=REPLACE_WITH_REAL_LONGITUDE

# pilot-4 since 2026-11-12 00:33 UTC (the camera was nudged). Unverified: set again at any later
# refocus or move; read the live value before relying on it.
SETUP_ID=pilot-4
# Unverified wording: the live note is not recorded in the repo.
SETUP_NOTE="UC-517, Pi 6 mm CS lens, on a shelf at the window"

# Night: 4 s at gain 1 with fixed colour gains (the script defaults; confirmed by the night sweep).
# NIGHT_LUX=5 unverified: not recorded as changed.
NIGHT_LUX=5
NIGHT_SHUTTER_US=4000000
NIGHT_GAIN=1
NIGHT_AWB=2.25,2.40

# Camera is upright: ROTATION unset (0). NETWATCH unset: wired Ethernet and Wi-Fi, no USB dongle.
SAVE_RAW=1
