# REFERENCE COPY of the non-secret settings in the live sunset.env on the Pi "sunshine" (CM4 on the
# MyPi XT board, IMX477 with the 3.2 mm lens on CAM0). It is NOT the live file: the Pi reads
# ~/sunset/sunset.env, which nothing here updates. Use this to rebuild the Pi: copy it to
# ~/sunset/sunset.env and set the two site values. Rebuild also needs `install.sh --uc517-cam0`
# (dtoverlay=imx477,cam0). Last checked against changelog.md and CLAUDE.md on 2026-11-15; values
# marked "unverified" were not read back from the Pi.
# Never put real coordinates, addresses or passwords in this file (the repo is public).
# systemd EnvironmentFile: no comments after a value, and no quotes unless the value needs them.

# Must not be "wide": CM4 frames would land in the other camera's series and keep its alert fresh.
CAM_NAME=cm4wide
NAS_TARGET=/mnt/nas-camera/project_sunshine/

# Site: placeholders. Replace with the real values on the Pi only (east-positive longitude).
SITE_LAT=REPLACE_WITH_REAL_LATITUDE
SITE_LON=REPLACE_WITH_REAL_LONGITUDE

# cm4-window-1 since 2026-11-12 00:30 UTC. Unverified: later changes are not recorded.
SETUP_ID=cm4-window-1
# Unverified wording: the live note is not recorded in the repo.
SETUP_NOTE="IMX477, 3.2 mm CS lens on CAM0, upside down, at the window"

# The camera is mounted upside down: frames and DNGs come out upright with 180.
ROTATION=180

# Night settings matched to this lens (about 1.3 stops less light than the 6 mm).
# NIGHT_LUX=2.3 set 2026-11-13; NIGHT_SHUTTER_US and NIGHT_AWB set 2026-11-12. NIGHT_GAIN=1
# is the script default and the sweep's best; unverified that it is set explicitly.
NIGHT_LUX=2.3
NIGHT_SHUTTER_US=8000000
NIGHT_GAIN=1
NIGHT_AWB=2.20,2.80

# Wi-Fi through a USB dongle: reset it after 10 min without the gateway, reboot after 30.
NETWATCH=1
SAVE_RAW=1
