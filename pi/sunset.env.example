CAM_NAME=wide
#OUT_ROOT=$HOME/sunset/outbox   # default; systemd does not expand $HOME here, so leave unset
# Either rsync over SSH (user@host:/path/) or a mounted share (/mnt/share/path/).
NAS_TARGET=sunset@nas.local:/volume1/project-sunset/
NIGHT_LUX=5
NIGHT_SHUTTER_US=8000000
NIGHT_GAIN=4
SAVE_RAW=1
# Site, for the sun position written into each frame's JSON (no network needed).
# SET YOUR OWN: east-positive longitude, so Burnaby is negative. These are only
# approximate Burnaby values; a 0.1 degree error moves sunset time by ~30 s.
SITE_LAT=49.25
SITE_LON=-122.98
# Optional guards (defaults shown): % full at which the DNG is dropped / the night
# frame is skipped, and the free MB below which nothing is captured.
#DISK_DROP_RAW_PCT=85
#DISK_SKIP_NIGHT_PCT=95
#DISK_MIN_FREE_MB=100
