CAM_NAME=wide
# 180 if the camera is mounted upside down: frames, DNGs and the diag page come out upright.
# Only 0 (default) and 180 are possible. Recorded in each frame's Capture.settings.
#ROTATION=180
#OUT_ROOT=$HOME/sunset/outbox   # default; systemd does not expand $HOME here, so leave unset
# Where frames go. Both Pis use the mounted share (docs/setup.md, section 3): a path under the
# mount. The sync refuses to run if that folder is missing or sits on the SD card, so an absent
# mount keeps the frames local. The folder must already exist on the share.
NAS_TARGET=/mnt/nas-camera/project_sunshine/
# Or rsync over SSH instead (user@host:/path/); this default is what the script uses with no setting:
#NAS_TARGET=sunset@nas.local:/volume1/project-sunset/
NIGHT_LUX=5
NIGHT_SHUTTER_US=4000000
NIGHT_GAIN=1
NIGHT_AWB=2.25,2.40
SAVE_RAW=1
# Site, for the sun position written into each frame's JSON (no network needed).
# SET YOUR OWN: east-positive longitude, so Burnaby is negative. These are only
# approximate Burnaby values; a 0.1 degree error moves sunset time by ~30 s.
SITE_LAT=49.25
SITE_LON=-122.98
# Physical setup, written into each frame's JSON. Change SETUP_ID whenever the camera, lens,
# focus, iris, mount or hood changes, so post-processing can tell the periods apart. Frames
# may be published one day, so keep the note free of addresses and names.
#SETUP_ID=pilot-1
#SETUP_NOTE="UC-517, unlabelled CS lens, before the bracket"
# 0 skips the SHA-256 of each image in the JSON, if a burst ever needs the time back.
#FRAME_CHECKSUMS=1
# Optional guards (defaults shown): % full at which the DNG is dropped / the night
# frame is skipped, and the free MB below which nothing is captured.
#DISK_DROP_RAW_PCT=85
#DISK_SKIP_NIGHT_PCT=95
#DISK_MIN_FREE_MB=100
# 1 on a Pi with a USB Wi-Fi dongle: reset the dongle after 10 min without network, reboot after
# 30 min (at most every 6 h). See docs/setup.md. Off by default.
#NETWATCH=1

# Capture timing. REQUIRE_TIME_SYNC=1 (default) refuses to capture until NTP has synced once since
# boot (a gap is better than frames with a wrong UTC name); 0 turns that off. CAPTURE_TIMEOUT_S is
# per rpicam-still call; DENSE_TIMEOUT_S the same in dense mode. SLOT_EVERY_MIN must match the
# capture timer (5). LOCK_WAIT_S: how long a regular capture waits for a dense one to finish.
#REQUIRE_TIME_SYNC=1
#CAPTURE_TIMEOUT_S=60
#DENSE_TIMEOUT_S=30
#SLOT_EVERY_MIN=5
#LOCK_WAIT_S=90

# When the camera fails (defaults shown). CAPTURE_KILL_S: seconds after the timeout before a stuck
# rpicam-still is killed outright. A regular day shot that fails in under CAPTURE_RETRY_UNDER_S
# seconds is tried once more after CAPTURE_RETRY_WAIT_S. CAPTURE_FAIL_REBOOT=1 reboots after
# CAPTURE_FAIL_REBOOT_N failures in a row, at most once every CAPTURE_FAIL_REBOOT_GAP_H hours.
# It is off by default: on 2026-11-05 a reboot did not bring the camera back. The capture user
# must be able to run "sudo -n systemctl reboot".
#CAPTURE_KILL_S=10
#CAPTURE_RETRY_UNDER_S=15
#CAPTURE_RETRY_WAIT_S=5
#CAPTURE_FAIL_REBOOT=0
#CAPTURE_FAIL_REBOOT_N=6
#CAPTURE_FAIL_REBOOT_GAP_H=6
# After a network-watchdog reboot, the clock is trusted without NTP for this many seconds from
# the time the watchdog noted just before rebooting.
#CLOCK_TRUST_MAX_S=900
# Seconds allowed for all of sunset-meta.py; probes not started by then are listed as unavailable.
#META_DEADLINE_S=15
# capture.log and netwatch.log are rotated to .1 at these sizes.
#CAPTURE_LOG_MAX_BYTES=10485760
#NETWATCH_LOG_MAX_BYTES=1048576

# Wi-Fi dongle watchdog, used only when NETWATCH=1 (defaults shown). Pings the gateway, or
# NETWATCH_TARGET if set; resets the dongle after RESET_MIN, reboots after REBOOT_MIN, and at most
# once every REBOOT_GAP_H hours. SETTLE_S: seconds to wait after a reset before checking again.
#NETWATCH_IFACE=wlan0
#NETWATCH_TARGET=
#NETWATCH_RESET_MIN=10
#NETWATCH_REBOOT_MIN=30
#NETWATCH_REBOOT_GAP_H=6
#NETWATCH_SETTLE_S=3

# Sync. Files go to the NAS in batches of the oldest first; a TERM at the unit timeout logs how
# many were left. sync.log is rotated to sync.log.1 at this size. Kernel log (kernel.log) likewise.
#SYNC_BATCH=200
#SYNC_LOG_MAX_BYTES=1048576
#KERNEL_LOG_MAX_BYTES=1048576

# Self-test thresholds (sunset-selftest.sh; estimates, tune from pilot data): slow capture in
# seconds, low memory in MB, and the mean R / mean G above which the image looks IR-contaminated.
#SLOW_CAPTURE_S=30
#LOW_MEM_MB=60
#IRCUT_RG_WARN=1.25
