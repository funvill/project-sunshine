CAM_NAME=wide
# 180 if the camera is mounted upside down: frames and the diag page come out upright.
# Only 0 (default) and 180 are possible. Recorded in each frame's Capture.settings.
#ROTATION=180
# Which camera, on a Pi with two (the CM4): its port ID as in `rpicam-hello --list-cameras`, e.g.
# i2c@0 for CAM0, or a number. rpicam numbers cameras in the order found, so prefer the port ID.
# No match, or more than one, skips the frame. Unset: rpicam's first camera.
#CAMERA=i2c@0
#OUT_ROOT=$HOME/sunset/outbox   # default; systemd does not expand $HOME here, so leave unset
# Where frames go. Both Pis use the mounted share (docs/setup.md, section 3): a path under the
# mount. The sync refuses to run if that folder is missing or sits on the SD card, so an absent
# mount keeps the frames local. The folder must already exist on the share.
NAS_TARGET=/mnt/nas-camera/project_sunshine/
# Or rsync over SSH instead (user@host:/path/); this default is what the script uses with no setting:
#NAS_TARGET=sunset@nas.local:/volume1/project-sunset/
NIGHT_LUX=5
NIGHT_SHUTTER_US=4000000
NIGHT_GAIN=1
NIGHT_AWB=2.25,2.40
# Site, for the sun position written into each frame's JSON (no network needed).
# SET YOUR OWN: east-positive longitude, so Burnaby is negative. These are only
# approximate Burnaby values; a 0.1 degree error moves sunset time by ~30 s.
SITE_LAT=49.25
SITE_LON=-122.98
# Physical setup, written into each frame's JSON. Change SETUP_ID whenever the camera, lens,
# focus, iris, mount or hood changes, so post-processing can tell the periods apart. Frames
# may be published one day, so keep the note free of addresses and names.
#SETUP_ID=pilot-1
#SETUP_NOTE="UC-517, unlabelled CS lens, before the bracket"
# The camera's view, for the sun-in-view check (#32): true bearing and tilt (degrees up) at the frame
# centre, field of view in degrees, and a margin added on every side. With VIEW_BEARING set, each
# frame's Sun block gets in_view and the sun's offset from the centre, and
# "sunset-sun.py view-calendar" lists the days and times the sun is in view. It does not protect the
# sensor (no shutter: the sun is on it whenever it is in view); the iris or an ND filter does that.
# Estimate for the 16 mm lens aimed at downtown; measure the real aim once it is fitted.
#VIEW_BEARING=281
#VIEW_HFOV=22.2
#VIEW_VFOV=16.8
#VIEW_TILT=2
#VIEW_MARGIN=3
# 0 skips the SHA-256 of each image in the JSON, if a burst ever needs the time back.
#FRAME_CHECKSUMS=1
# Optional guards (defaults shown): % full at which the night frame is skipped, and the
# free MB below which nothing is captured.
#DISK_SKIP_NIGHT_PCT=95
#DISK_MIN_FREE_MB=100
# 1 on a Pi with a USB Wi-Fi dongle: reset the dongle after 10 min without network, reboot after
# 30 min (at most every 6 h). See docs/setup.md. Off by default.
#NETWATCH=1
# 1: reboot when one camera fails 3 captures within 60 min (at most every 6 h). See docs/setup.md.
# Off by default.
#CAMWATCH=1

# Capture timing. REQUIRE_TIME_SYNC=1 (default) refuses to capture until NTP has synced once since
# boot (a gap is better than frames with a wrong UTC name); 0 turns that off. CAPTURE_TIMEOUT_S is
# per rpicam-still call; DENSE_TIMEOUT_S the same in dense mode. SLOT_EVERY_MIN must match the
# capture timer (5). LOCK_WAIT_S: how long a regular capture waits for a dense one to finish.
#REQUIRE_TIME_SYNC=1

# Refuse to capture when this sunset.env is missing or empty: without it CAM_NAME falls back to
# "wide" with no ROTATION, and a rebuilt CM4 would write into the wide series. Unset, it is 1
# unless OUT_ROOT is set by the caller (the offline tests set it). Leave it unset on the Pis.
#REQUIRE_ENV_FILE=1
#CAPTURE_TIMEOUT_S=60
#DENSE_TIMEOUT_S=30

# Sunset bracket (#10, option E; off until Steven's go-ahead). With BRACKET=1 every frame (regular
# or dense) within BRACKET_WINDOW_MIN of sunset is followed by an ev+0 and an ev-2 shot, saved
# beside it as <frame>_ev0.* and <frame>_ev-2.* (JPEG + JSON, Capture.kind "bracket"). Daylight
# white balance until BRACKET_AWB_HANDOVER_MIN after sunset, then auto (the city lights the cloud
# and daylight turns it brown). BRACKET_SETTLE_MS: the shots' -t. A failed bracket shot is
# logged and never costs the frame. tools/fuse_sunset.py merges the pairs
# (tools/build_video.py --fuse-production). About 180 extra JPEGs a day per camera.
#BRACKET=0
#BRACKET_WINDOW_MIN=45
#BRACKET_AWB_HANDOVER_MIN=10
#BRACKET_SETTLE_MS=1000
# A name for the frozen capture settings, written as Capture.profile_id (settings freeze Dec 14).
#PROFILE_ID=
#SLOT_EVERY_MIN=5
#LOCK_WAIT_S=90

# When the camera fails (defaults shown). CAPTURE_KILL_S: seconds after the timeout before a stuck
# rpicam-still is killed outright. A regular day shot that fails in under CAPTURE_RETRY_UNDER_S
# seconds is tried once more after CAPTURE_RETRY_WAIT_S. CAPTURE_FAIL_WARN_N failures in a row
# log a warning. Rebooting on camera failures is the camera watchdog's job (CAMWATCH=1).
#CAPTURE_KILL_S=10
#CAPTURE_RETRY_UNDER_S=15
#CAPTURE_RETRY_WAIT_S=5
#CAPTURE_FAIL_WARN_N=6
# After a network-watchdog reboot, the clock is trusted without NTP for this many seconds from
# the time the watchdog noted just before rebooting.
#CLOCK_TRUST_MAX_S=900
# Seconds allowed for all of sunset-meta.py; probes not started by then are listed as unavailable.
#META_DEADLINE_S=15
# capture.log and netwatch.log are rotated to .1 at these sizes.
#CAPTURE_LOG_MAX_BYTES=10485760
#NETWATCH_LOG_MAX_BYTES=1048576

# Wi-Fi dongle watchdog, used only when NETWATCH=1 (defaults shown). Pings the gateway, or
# NETWATCH_TARGET if set; resets the dongle after RESET_MIN, reboots after REBOOT_MIN, and at most
# once every REBOOT_GAP_H hours. SETTLE_S: seconds to wait after a reset before checking again.
#NETWATCH_IFACE=wlan0
#NETWATCH_TARGET=
#NETWATCH_RESET_MIN=10
#NETWATCH_REBOOT_MIN=30
#NETWATCH_REBOOT_GAP_H=6
#NETWATCH_SETTLE_S=3

# Camera watchdog, used only when CAMWATCH=1 (defaults shown). Counts each camera's failed captures
# in capture.log since boot within WINDOW_MIN; FAILS or more reboots, at most once every
# REBOOT_GAP_H hours. camwatch.log is rotated to .1 at LOG_MAX_BYTES.
#CAMWATCH_FAILS=3
#CAMWATCH_WINDOW_MIN=60
#CAMWATCH_REBOOT_GAP_H=6
#CAMWATCH_LOG_MAX_BYTES=1048576

# Sync. Files go to the NAS in batches of the oldest first; a TERM at the unit timeout logs how
# many were left. sync.log is rotated to sync.log.1 at this size. Kernel log (kernel.log) likewise.
#SYNC_BATCH=200
# A batch also closes at SYNC_BATCH_MB, so on a slow link each batch is read back and deleted
# within minutes. After SYNC_MAX_S seconds the run stops between batches ("sync partial") and
# the next timer run carries on; the unit's 60-minute limit is only a backstop. 0 turns either off.
#SYNC_BATCH_MB=32
#SYNC_MAX_S=1200
#SYNC_LOG_MAX_BYTES=1048576
#KERNEL_LOG_MAX_BYTES=1048576
# Read-back before delete (mounted share only; over SSH rsync deletes as before). With
# SYNC_VERIFY=1 a frame file leaves the SD card only after its NAS copy has been read back and
# matches: same size, plus the same SHA-256 for files up to SYNC_VERIFY_HASH_MAX_MB (the JPEG and
# JSON; a larger file gets the size check only). A file that fails stays on the card, is logged
# in sync.log ("readback kept ...") and is sent again on the next run.
# 0 for SYNC_VERIFY trusts rsync's exit code (the old behaviour).
#SYNC_VERIFY=1
#SYNC_VERIFY_HASH_MAX_MB=8
# Config backup (mounted share only): sunset.env, /etc/fstab and /boot/firmware/config.txt (or
# /boot/config.txt) are copied to <share>/project_sunshine_config/<hostname>/ when one changes,
# and once a UTC day. Never the NAS login file. 0 turns it off. SYNC_CONFIG_DIR replaces the
# folder, SYNC_CONFIG_ENV the sunset.env path (default: next to the outbox), and SYNC_CONFIG_ROOT
# is put in front of /etc and /boot (for tests; leave unset on a Pi).
#SYNC_CONFIG_BACKUP=1
#SYNC_CONFIG_DIR=
#SYNC_CONFIG_ENV=
#SYNC_CONFIG_ROOT=
# UPS log (with the config backup, mounted share only): ups.log next to the outbox and its rotated
# files go to <config folder>/ups/ups-<first line's UTC>.log, each copied again only when its size
# on the share differs. Nothing happens on a Pi without a ups.log.
#SYNC_UPS_LOG=
#SYNC_UPS_DIR=

# UPS monitor (sunset-ups.py / sunset-ups.service, the CM4 on the Mini-Box OpenUPS2 only; issue
# #29). Read-only over USB HID. Polls every UPS_POLL_S; writes ups.log only on a change beyond a
# deadband, an event, and a keyframe every UPS_KEYFRAME_S; the live status is in UPS_STATUS_FILE
# (RAM), which sunset-meta.py copies into each frame's System.ups. On battery with a cell below
# UPS_LOW_CELL_V it stops the capture, dense (both cameras) and sync timers that are running, and
# starts them again when mains returns; UPS_PAUSE=0 only logs. The board's charge % stays at 100
# on battery, so only the cell voltage decides. 3.3 V (was
# 3.45 V until 2026-11-21) leaves room below the ~3.5-3.6 V the cells rest at with R20 unchanged.
#UPS_HIDRAW=
#UPS_POLL_S=10
#UPS_KEYFRAME_S=14400
#UPS_LOG_FILE=
#UPS_LOG_MAX_BYTES=262144
#UPS_LOG_KEEP=14
#UPS_STATUS_FILE=/run/sunset-ups.json
#UPS_LOW_CELL_V=3.3
#UPS_WARN_TEMP_C=40
#UPS_PAUSE=1
#UPS_PAUSE_UNITS=
#UPS_PAUSE_FLAG=/run/sunset-ups.paused

# Self-test thresholds (sunset-selftest.sh; estimates, tune from pilot data): slow capture in
# seconds, low memory in MB, and the mean R / mean G above which the image looks IR-contaminated.
#SLOW_CAPTURE_S=30
#LOW_MEM_MB=60
#IRCUT_RG_WARN=1.25
