CAM_NAME=wide
# 180 if the camera is mounted upside down: frames, DNGs and the diag page come out upright.
# Only 0 (default) and 180 are possible. Recorded in each frame's Capture.settings.
#ROTATION=180
#OUT_ROOT=$HOME/sunset/outbox   # default; systemd does not expand $HOME here, so leave unset
# Either rsync over SSH (user@host:/path/) or a mounted share (/mnt/share/path/).
NAS_TARGET=sunset@nas.local:/volume1/project-sunset/
NIGHT_LUX=5
NIGHT_SHUTTER_US=4000000
NIGHT_GAIN=1
NIGHT_AWB=2.25,2.40
SAVE_RAW=1
# Site, for the sun position written into each frame's JSON (no network needed).
# SET YOUR OWN: east-positive longitude, so Burnaby is negative. These are only
# approximate Burnaby values; a 0.1 degree error moves sunset time by ~30 s.
SITE_LAT=49.25
SITE_LON=-122.98
# Physical setup, written into each frame's JSON. Change SETUP_ID whenever the camera, lens,
# focus, iris, mount or hood changes, so post-processing can tell the periods apart. Frames
# may be published one day, so keep the note free of addresses and names.
#SETUP_ID=pilot-1
#SETUP_NOTE="UC-517, unlabelled CS lens, before the bracket"
# 0 skips the SHA-256 of each image in the JSON, if a burst ever needs the time back.
#FRAME_CHECKSUMS=1
# Optional guards (defaults shown): % full at which the DNG is dropped / the night
# frame is skipped, and the free MB below which nothing is captured.
#DISK_DROP_RAW_PCT=85
#DISK_SKIP_NIGHT_PCT=95
#DISK_MIN_FREE_MB=100
