# Second camera on the same Pi (the CM4's CAM1, from 2026-11-17). Copy to ~/sunset/sunset2.env.
# The capture and dense services run sunset-capture.sh a second time with --env sunset2.env, right
# after the first camera: sunset.env is loaded first, then this file, so anything set here wins and
# everything else (site, NAS, bracket) comes from sunset.env. Both share the capture lock, so only one
# camera shoots at a time, and the frames go to their own folder: outbox/<CAM_NAME>/ and the NAS.

CAM_NAME=cm4city
# By port ID, not number: rpicam numbers cameras in the order it finds them.
CAMERA=i2c@1
ROTATION=0
# The 6 mm lens on the UC-517 board: the settings it used on timelaps (night sweep, 2026-11-06).
NIGHT_LUX=5
NIGHT_SHUTTER_US=4000000
NIGHT_GAIN=1
NIGHT_AWB=2.25,2.40
SETUP_ID=cm4city-window-1
SETUP_NOTE="Arducam UC-517 (IMX477), official Pi 6 mm CS lens, CM4 CAM1, at the window, about 281 deg (downtown)"
